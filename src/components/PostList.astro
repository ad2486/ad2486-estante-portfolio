---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib";

type Props = { posts: CollectionEntry<"posts">[] };
const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="muted">Nenhum post ainda.</p>
) : (
  <ul class="list">
    {posts.map((p) => (
      <li>
        <a href={`/posts/${p.id}/`}>
          <span class="t">{p.data.title}</span>
          <time class="d mono muted" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
        </a>
      </li>
    ))}
  </ul>
)}
