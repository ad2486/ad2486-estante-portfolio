---
import type { CollectionEntry } from "astro:content";
import { hasReview } from "../lib";
import Stars from "./Stars.astro";

type Props = { livros: CollectionEntry<"livros">[] };
const { livros } = Astro.props;
---

{livros.length === 0 ? (
  <p class="muted">Nenhum livro ainda.</p>
) : (
  <ul class="shelf">
    {livros.map((b) => {
      const review = hasReview(b);
      const Tag = review ? "a" : "div";
      return (
        <li>
          <Tag class="book" href={review ? `/estante/${b.id}/` : undefined}>
            {b.data.cover ? (
              <img src={b.data.cover} alt="" loading="lazy" width="200" height="300" />
            ) : (
              <span class="nocover mono" aria-hidden="true">{b.data.title}</span>
            )}
            <span class="title">{b.data.title}</span>
            <span class="muted author">{b.data.author}</span>
            <Stars rating={b.data.rating} />
            {review && <span class="mono review">resenha →</span>}
          </Tag>
        </li>
      );
    })}
  </ul>
)}

<style>
  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 2rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .book {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }
  img,
  .nocover {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 4px;
    margin-bottom: 0.5rem;
    background: var(--surface);
  }
  .nocover {
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
    font-size: 0.7rem;
    color: var(--muted);
  }
  a.book img,
  a.book .nocover {
    transition: border-color 0.3s var(--ease);
  }
  a.book:hover img,
  a.book:hover .nocover {
    border-color: var(--accent);
  }
  .title {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .author {
    font-size: 0.8rem;
  }
  .review {
    font-size: 0.7rem;
    color: var(--accent);
  }
</style>
